# --- Server Configuration ---
PORT=5001
JWT_SECRET=replace_with_a_long_random_secret

# --- Database & Storage Configuration ---
MONGODB_URI=mongodb://127.0.0.1:27017/mediscan
UPLOADS_DIR=./uploads

# --- Clinical AI & LLM Configuration ---
# Optional: Add your Google Gemini API key to query live models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google OAuth Credentials ---
# Add your Google Developer Console OAuth credentials below to replace the simulator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP Email Server (for Login OTP & Password Reset) ---
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="MediScan AI Security" <your-email@gmail.com>

# --- Frontend API Reference ---
# Used to link the React Vite client
VITE_API_URL=http://localhost:5001/api
